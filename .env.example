# Target network: 43113 = Avalanche Fuji (default), 11155111 = legacy Ethereum Sepolia deployment
NEXT_PUBLIC_CHAIN_ID=43113
# Optional custom RPC (defaults: Avalanche public API + PublicNode fallback)
NEXT_PUBLIC_RPC_URL=
# Fill these after deploying contracts to Fuji (forge script script/Deploy.s.sol --rpc-url fuji --broadcast)
NEXT_PUBLIC_CHARITY_CORE_ADDRESS=0xB1dE316be780D4c779f93A5EE37A9D44d3344de9
NEXT_PUBLIC_DONATION_VAULT_ADDRESS=0xf1A52fa0fA5d88387a00B59aa35040E48b7a709C
NEXT_PUBLIC_GOVERNANCE_DAO_ADDRESS=0xeb5C41b35111943AF1395Da6337B3147c3f5cCa3
NEXT_PUBLIC_IMPACT_NFT_ADDRESS=0xD52B2385a3853e4C97928e59E8012569723C50DF
# Circle USDC on Fuji
NEXT_PUBLIC_USDC_ADDRESS=0x5425890298aed601595a70AB815c96711a31Bc65
# V2 Module A/C — leave empty / zero until DeployV2; UI shows placeholders
NEXT_PUBLIC_DISBURSEMENT_CONTROLLER_ADDRESS=
NEXT_PUBLIC_YIELD_MANAGER_ADDRESS=
NEXT_PUBLIC_DISBURSEMENT_SAFE=
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
